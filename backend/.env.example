# ==============================================================================
# CAMPVION — CLOUD-FIRST ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and configure your production environment variables.
# NEVER commit .env with actual API keys or secrets to GitHub or version control.
# ==============================================================================

# Core Application Settings
APP_NAME=CampVion
APP_VERSION=0.2.0
ENVIRONMENT=production
DATABASE_URL=sqlite:///./axora.db
API_PREFIX=/api

# ------------------------------------------------------------------------------
# Cloud-First LLM Architecture Configuration (PRIMARY PROVIDER: GROQ)
# ------------------------------------------------------------------------------
# LLM Provider Selection:
#   - "groq"   (Primary Cloud Provider: High-speed Groq LPU inference)
#   - "gemini" (Alternative Cloud Provider: Google Gemini)
#   - "openai" (Universal Cloud Provider: OpenAI, OpenRouter, Azure)
#   - "mock"   (Offline deterministic mock for CI/CD test suites & offline dev)
#   - "ollama" (Optional local inference adapter; NOT required for deployment)
LLM_PROVIDER=groq

# Primary Cloud Model Identifier:
# Verified Groq models:
#   - "qwen/qwen3.8-27b"        (Active & Verified: 131k context, excellent JSON schema compliance)
#   - "openai/gpt-oss-120b"     (131k context, reasoning model)
#   - "llama-3.3-70b-versatile" (If provisioned for your organization)
GROQ_MODEL=qwen/qwen3.8-27b

# Cloud LLM API Credentials (Server-Side Only - Never expose to frontend):
GROQ_API_KEY=your_groq_api_key_here

# Alternative Provider Keys (Optional):
LLM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Custom Base URL (Leave empty for default official Groq endpoint: https://api.groq.com/openai/v1):
LLM_BASE_URL=

# ------------------------------------------------------------------------------
# Cost Control, Token Bounds & Resilience Guardrails
# ------------------------------------------------------------------------------
# Request timeout in seconds (prevents hanging requests):
LLM_TIMEOUT_SECONDS=30.0

# Maximum retries with exponential backoff on HTTP 429 rate limits or transient errors:
LLM_MAX_RETRIES=2

# Maximum allowable input character count (prevents cost spikes and prompt ballooning):
LLM_MAX_INPUT_LENGTH=2000

# Maximum generated output tokens per request:
LLM_MAX_OUTPUT_TOKENS=1024

# Temperature for structured extraction (lower = more deterministic & policy-aligned):
LLM_TEMPERATURE=0.1

# ------------------------------------------------------------------------------
# Optional Local Inference Adapter (Ollama)
# ------------------------------------------------------------------------------
# NOTE: CampVion does NOT require Ollama for deployment, startup, or normal operation.
# These variables are only active if LLM_PROVIDER is explicitly set to "ollama".
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# Authentication, Session Management & Password Recovery
# ------------------------------------------------------------------------------
SESSION_COOKIE_NAME=campvion_session
CSRF_COOKIE_NAME=campvion_csrf
SESSION_DURATION_HOURS=24
SESSION_REMEMBER_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Optional comma-separated institutional domains (e.g. lpu.edu,campvion.edu). Leave empty to allow any valid email.
ALLOWED_EMAIL_DOMAINS=

# ------------------------------------------------------------------------------
# Optional Transactional Email (SMTP) for Password Recovery
# ------------------------------------------------------------------------------
# Leave SMTP_HOST empty in local development to use the development outbox mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@campvion.edu
FRONTEND_BASE_URL=http://localhost:3000
